# Copy to .env.local and adjust.
# 1 = stub ON (default for local demos without hardware/API keys)
# 0 = use real implementation in that lane

NEXT_PUBLIC_STUB_MIC=1
NEXT_PUBLIC_STUB_CAMERA=1
NEXT_PUBLIC_STUB_ANALYZE=1

# Lane D — only needed when NEXT_PUBLIC_STUB_ANALYZE=0
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
